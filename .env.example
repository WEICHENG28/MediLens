# MediLens 后端配置示例。复制为 .env 后填写；.env 不得提交到仓库。密钥只放后端，绝不放进 APP。
# 未填写密钥时自动使用 mock，全流程仍可跑通。

# ---- 大模型（仅中国大陆可直接访问的服务）----
# 可选：mock / deepseek / qwen / zhipu
LLM_PROVIDER=mock

# DeepSeek（https://api-docs.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 通义千问 / 阿里云百炼（https://help.aliyun.com/zh/model-studio/）
# 北京地域地址需替换 {WorkspaceId}：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus

# 智谱（https://docs.bigmodel.cn）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash

# ---- 以下为待实现功能预留（本轮未使用）----
# 实时语音：讯飞开放平台
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# 实时语音备选：阿里云智能语音交互
ALIYUN_NLS_APPKEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 云端 OCR（仅注册用户授权后）：百度智能云 / 腾讯云
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 云备份对象存储：阿里云 OSS / 腾讯云 COS
OSS_BUCKET=
OSS_ENDPOINT=

# 数据库（docker-compose 中使用 PostgreSQL；本地开发可不填）
DATABASE_URL=
